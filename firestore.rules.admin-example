rules_version = '2';
// Complete rule set for every collection the app uses. Publish it in
// Firebase console > Firestore > Rules (or merge it into your existing rules).
// The app only hides admin UI client-side; these rules are what actually enforce access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // A block document uses the same id as the connection/conversation it applies to ("uidA~uidB").
    function blocked(pairId) { return exists(/databases/$(database)/documents/blocks/$(pairId)); }

    // Admin role: a doc at admins/{uid}. Users may only read their own; nobody can write
    // from the client. Create admins in the Firebase console or with the Admin SDK.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();          // lets the dashboard count admins
      allow write: if false;
    }

    // Site settings: everyone signed in reads, only admins write.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();   // people search and profiles need every signed-in user to read the directory
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.disabled == false;
      // Owners edit their own profile, likes, saved jobs, presence and dismissed suggestions,
      // but never the "disabled" flag. Admins may change only that flag.
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.disabled == resource.data.disabled)
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']));
      allow delete: if false;

      // Notifications: the recipient reads and marks them read. Any signed-in user may create
      // one for someone else, but only as itself (actorId must be the caller).
      match /notifications/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if signedIn() && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.recipientId == uid
                      && request.resource.data.kind is string;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      // Posting can be paused site-wide; admins are exempt.
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
                    && (isAdmin() || get(/databases/$(database)/documents/settings/site).data.get('postingEnabled', true) == true);
      // Authors edit their own text. Anyone may only change the like or comment counters.
      allow update: if signedIn() && (resource.data.authorId == request.auth.uid
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid
                      || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
                      || isAdmin());
      }
    }

    // Connections: doc id is the two uids sorted and joined with "~". Only the recipient can accept.
    match /connections/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.to in request.resource.data.users
                    && request.resource.data.from != request.resource.data.to
                    && !blocked(id);
      allow update: if signedIn() && resource.data.to == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted';
      // Either side can withdraw, decline or remove the connection. Deleting a missing document is
      // allowed as a no-op, so blocking someone with no connection still succeeds in one batch.
      allow delete: if signedIn() && (resource == null || request.auth.uid in resource.data.users);
    }

    // Blocks: created and removed only by the member who blocked. Both members can read,
    // so the app can hide each side from the other.
    match /blocks/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.resource.data.blockedBy == request.auth.uid
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users;
      allow delete: if signedIn() && resource.data.blockedBy == request.auth.uid;
      allow update: if false;
    }

    // Conversations: same doc id scheme. Messages live in a subcollection.
    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && !blocked(cid);
      allow update: if signedIn() && request.auth.uid in resource.data.users;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.users;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
                      && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.users
                      && !blocked(cid);
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Jobs: any signed-in user can post; only the poster edits or deletes. Catalog listings
    // (postedBy == 'catalog') are written only by an admin.
    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if (signedIn() && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.status in ['open', 'closed']
                      && request.resource.data.title is string && request.resource.data.title.size() > 0)
                    || (isAdmin() && request.resource.data.postedBy == 'catalog');
      allow update: if (signedIn() && resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.status in ['open', 'closed'])
                    || (isAdmin() && resource.data.postedBy == 'catalog'
                      && request.resource.data.postedBy == 'catalog');
      allow delete: if (signedIn() && resource.data.postedBy == request.auth.uid)
                    || (isAdmin() && resource.data.postedBy == 'catalog');
    }

    // Applications: one document per applicant and job ("<uid>~<jobId>"). The applicant can apply
    // to an open job and withdraw. The poster can read applicants and move their status.
    match /applications/{appId} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid
                  || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
                    && appId == request.auth.uid + '~' + request.resource.data.jobId
                    && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.ownerId != request.auth.uid
                    && request.resource.data.status == 'Submitted'
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy == request.resource.data.ownerId
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open';
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['Submitted', 'Reviewing', 'Interview', 'Offer', 'Rejected'];
      allow delete: if signedIn() && (resource.data.applicantId == request.auth.uid
                    || resource.data.ownerId == request.auth.uid);
    }
  }
}
