rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function blocked(pairId) {
      return exists(/databases/$(database)/documents/blocks/$(pairId));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.disabled == false;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.disabled == resource.data.disabled;
      allow delete: if false;

      match /notifications/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read is bool;
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly([
                        'recipientId', 'actorId', 'kind', 'text', 'icon', 'target', 'read', 'createdAt'
                      ])
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.recipientId == uid
                      && request.resource.data.kind is string
                      && request.resource.data.text is string
                      && request.resource.data.read == false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
                    && (isAdmin() || get(/databases/$(database)/documents/settings/site).data.get('postingEnabled', true) == true);
      allow update: if signedIn() && (resource.data.authorId == request.auth.uid
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid
                      || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
                      || isAdmin());
      }
    }

    match /connections/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['users', 'from', 'to', 'status', 'createdAt'])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] == request.resource.data.from
                    && request.resource.data.users[1] == request.resource.data.to
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && (id == request.resource.data.from + '~' + request.resource.data.to
                        || id == request.resource.data.to + '~' + request.resource.data.from)
                    && !blocked(id);
      allow update: if signedIn()
                    && request.auth.uid == resource.data.to
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.acceptedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if signedIn()
                    && (resource == null || request.auth.uid in resource.data.users);
    }

    match /blocks/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.resource.data.blockedBy == request.auth.uid
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users;
      allow delete: if signedIn() && resource.data.blockedBy == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && !blocked(cid);
      allow update: if signedIn() && request.auth.uid in resource.data.users;

      match /messages/{mid} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.users;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
                      && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.users
                      && !blocked(cid);
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if (signedIn() && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.status in ['open', 'closed']
                      && request.resource.data.title is string && request.resource.data.title.size() > 0)
                    || (isAdmin() && request.resource.data.postedBy == 'catalog');
      allow update: if (signedIn() && resource.data.postedBy == request.auth.uid
                      && request.resource.data.postedBy == request.auth.uid
                      && request.resource.data.status in ['open', 'closed'])
                    || (isAdmin() && resource.data.postedBy == 'catalog'
                      && request.resource.data.postedBy == 'catalog');
      allow delete: if (signedIn() && resource.data.postedBy == request.auth.uid)
                    || (isAdmin() && resource.data.postedBy == 'catalog');
    }

    match /applications/{appId} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid
                  || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
                    && appId == request.auth.uid + '~' + request.resource.data.jobId
                    && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.ownerId != request.auth.uid
                    && request.resource.data.status == 'Submitted'
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy == request.resource.data.ownerId
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open';
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['Submitted', 'Reviewing', 'Interview', 'Offer', 'Rejected'];
      allow delete: if signedIn() && (resource.data.applicantId == request.auth.uid
                    || resource.data.ownerId == request.auth.uid);
    }
  }
}
