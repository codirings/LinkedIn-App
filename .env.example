# Copy this file to `.env` (npm install does it for you if `.env` is missing).
# Run `npm run env` (or just `npm start` / `npm run android` / `npm run ios`)
# after editing so the values are picked up by the app.

# OAuth "Web client" ID (client_type 3) from your Firebase / Google Cloud project.
# Found in android/app/google-services.json -> oauth_client, or in the Firebase console
# under Authentication -> Sign-in method -> Google -> Web SDK configuration.
GOOGLE_WEB_CLIENT_ID=7221468978-7h604mt4chlf7idbv3bq99ltlc1em6q4.apps.googleusercontent.com

# Gemini model used by Firebase AI Logic. Gemini 2.5 is closed to new projects, so default to 3.8.
AI_MODEL=gemini-3.8-flash

# App Check debug secret (any UUID). Register it once in Firebase console > App Check > your Android app > Manage debug tokens.
# Debug builds always use the debug provider; release builds use Play Integrity.
APPCHECK_DEBUG_TOKEN=
